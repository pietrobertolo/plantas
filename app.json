{
  "expo": {
    "name": "sobre-plantas",
    "slug": "sobre-plantas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/imagemdeplantarealofficial.png",
    "scheme": "sobreplantas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/imagemdeplantarealofficial.png",
        "backgroundImage": "./assets/images/imagemdeplantarealofficial.png",
        "monochromeImage": "./assets/images/imagemdeplantarealofficial.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pietromartins.sobreplantas"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/imagemdeplantarealofficial.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/imagemdeplantarealofficial.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2940ea4e-78e2-4235-87fe-5ae628d1f0b0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2940ea4e-78e2-4235-87fe-5ae628d1f0b0"
    }
  }
}
